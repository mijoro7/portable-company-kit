# Multica workspace id (find via `multica workspace list`)
MULTICA_WORKSPACE_ID=

# Multica uses cookie-based auth — `multica login` handles it. Do NOT set
# MULTICA_TOKEN in .env; exporting any value here (even empty) will REPLACE
# the real cookie and break every call with "Your session has expired".

# Default OpenClaw runtime to use (UUID or `default` for first installed).
# Find with `openclaw runtime list --output json`.
OPENCLAW_RUNTIME_ID=default

# Default model the OpenClaw agents invoke (per your runtime's catalog).
OPENCLAW_AGENT_MODEL=ollama/minimax-m3:cloud

# Founder's timezone (used by autopilot cron triggers and the CEO standup).
# Examples: Africa/Nairobi, America/New_York, Europe/Paris
STANDUP_TZ=Africa/Nairobi
# Cron expression — KEEP QUOTED so bash does not glob `*`.
STANDUP_CRON='0 9 * * *'

# Brand voice — the company name baked into the workspace skill.
COMPANY_NAME=

# The four departments. Default set is Growth/Sales/Product/Success.
# Override only if you rename them.
DEPARTMENTS=Growth,Sales,Product,Success

# AgentPulse integration (for the one-way Multica -> AgentPulse sync).
# Find at https://api.rectify.so/v1/agent-pulse (Rectify dashboard)
# Leave empty if you don't use AgentPulse — sync script will be a no-op.
RECTIFY_GATEWAY_TOKEN=
RECTIFY_PROJECT_ID=6a4b8374d8c4fdd53d59185d

# Notification chat id for "doc created" alerts (Feishu/Lark defaults shown).
# Override only if you have your own standard chat.
NOTIFY_CHAT_ID=oc_7aa31b9c966553cd4ed16facff519bd7
